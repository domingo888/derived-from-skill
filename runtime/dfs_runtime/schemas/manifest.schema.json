{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derived-from-skill/schemas/manifest.schema.json",
  "title": "DFS Capsule Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "source", "model", "io", "ui"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": { "type": "string", "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "skills", "provenance"],
      "properties": {
        "kind": { "type": "string", "enum": ["skill", "skill-set"] },
        "skills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "origin"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "origin": {
                "type": "string",
                "enum": ["original", "github", "clawhub", "local-import", "other"]
              },
              "upstream_url": { "type": "string" },
              "author": { "type": "string" },
              "license": { "type": "string" },
              "version": { "type": "string" },
              "imported_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "note": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "enum": ["openai-compatible", "mock"] },
        "model": { "type": "string" },
        "base_url": { "type": "string" },
        "auth": { "type": "string", "enum": ["bearer", "none"] },
        "api_key_env": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 64 },
        "timeout_s": { "type": "integer", "minimum": 1 }
      }
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 16
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["web", "window", "none"] },
        "title": { "type": "string", "maxLength": 120 },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "entry": { "type": "string" },
        "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "note": { "type": "string" }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_schema", "output_schema"],
      "properties": {
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" }
      }
    }
  }
}
